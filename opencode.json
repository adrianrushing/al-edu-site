{
    "$schema": "https://opencode.ai/config.json",
   "permission": {
    "websearch": "allow"
    },
      "mcp": {
        "postgres": {
            "type": "local",
            "command": [
                "docker",
                "run",
                "-i",
                "--rm",
                "--name",
                "opencode-postgres-mcp",
                "--network=host",
                "-e",
                "DATABASE_URI",
                "crystaldba/postgres-mcp",
                "--access-mode=unrestricted"
            ],
            "environment": {
                "DATABASE_URI": "postgresql://eflt_etl:1qaz2wsx3edc@127.0.0.1:15432/eflt?sslmode=disable"
            }
        },
        "shadcn": {
            "type": "local",
            "command": ["npx", "shadcn@latest", "mcp"]
        },
        "marimo": {
            "type": "remote",
            "url": "http://localhost:PORT/mcp/server"
        }
    }
}
