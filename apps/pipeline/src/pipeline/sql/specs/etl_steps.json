{
    "version": "2026-04-20",
    "steps": [
        {
            "name": "ingest_raw_csv_sources",
            "source": "flat_data/in/raw_data/**/*.csv",
            "target_layer": "bronze",
            "target_table": "bronze.raw_csv_records"
        },
        {
            "name": "ingest_school_accountability",
            "source": "flat_data/in/raw_data/school_accountability/*.csv",
            "target_layer": "bronze",
            "target_table": "bronze.raw_csv_records"
        },
        {
            "name": "ingest_school_edunomics",
            "source": "flat_data/in/raw_data/school_edunomics/*.csv",
            "target_layer": "bronze",
            "target_table": "bronze.raw_csv_records"
        },
        {
            "name": "ingest_student_demographics",
            "source": "flat_data/in/raw_data/student_demographics/*.csv",
            "target_layer": "bronze",
            "target_table": "bronze.raw_csv_records"
        },
        {
            "name": "ingest_teacher_demographics",
            "source": "flat_data/in/raw_data/teacher_demographics/*.csv",
            "target_layer": "bronze",
            "target_table": "bronze.raw_csv_records"
        },
        {
            "name": "ingest_teacher_experience",
            "source": "flat_data/in/raw_data/teacher_experience/*.csv",
            "target_layer": "bronze",
            "target_table": "bronze.raw_csv_records"
        },
        {
            "name": "ingest_teacher_effectiveness",
            "source": "flat_data/in/raw_data/teacher_effectiveness/*.csv",
            "target_layer": "bronze",
            "target_table": "bronze.raw_csv_records"
        },
        {
            "name": "canonical_references",
            "source": "sql/ref_*",
            "target_layer": "ref",
            "target_table": "ref.*"
        },
        {
            "name": "review_models",
            "source": "silver + ref",
            "target_layer": "sandbox",
            "target_table": "sandbox.*_review"
        },
        {
            "name": "publish_serving_tables",
            "source": "sandbox + ref",
            "target_layer": "gold",
            "target_table": "gold.*"
        },
        {
            "name": "publish_materialized_views",
            "source": "gold",
            "target_layer": "platinum",
            "target_table": "platinum.mv_*"
        }
    ]
}
